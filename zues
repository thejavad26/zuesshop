    box.innerHTML = "";

    currentProduct.skins.forEach((skin,index)=>{

        const btn =
            document.createElement("button");

        btn.className =
            "option" +
            (index === 0 ? " selected" : "");

        btn.innerText = skin;

        btn.onclick = () => {

            selectedSkin = skin;

            box
                .querySelectorAll(".option")
                .forEach(x =>
                    x.classList.remove("selected")
                );

            btn.classList.add("selected");

            updateDetailPrice();

        };

        box.appendChild(btn);

    });

}


