        phone +
        "\n\n";


    cart.forEach((item,index)=>{

        message +=
            `🎮 آیتم ${index + 1}\n` +
            `🔫 ${item.name}\n` +
            `🎨 Skin: ${item.skin}\n` +
            `📦 Wear: ${item.wear}\n` +
