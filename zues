function generateFloat(){

    let min = 0.00;
    let max = 1.00;

    if(selectedWear === "Factory New"){
        min = 0.00;
        max = 0.07;
    }

    if(selectedWear === "Minimal Wear"){
        min = 0.07;
        max = 0.15;
    }

    if(selectedWear === "Field-Tested"){
        min = 0.15;
        max = 0.38;
    }

    if(selectedWear === "Well-Worn"){
        min = 0.38;
        max = 0.45;
    }

    if(selectedWear === "Battle-Scarred"){
        min = 0.45;
        max = 1.00;
    }

    const value =
        Math.random() * (max - min) + min;

    document
        .getElementById("floatValue")
        .innerText =
        value.toFixed(6);

}


/* =========================================================
   PRICE
========================================================= */

function updateDetailPrice(){

    if(!currentProduct) return;

    let price =
        currentProduct.price;


    if(selectedWear === "Minimal Wear")
        price *= 1.12;

    if(selectedWear === "Field-Tested")
        price *= 0.92;

    if(selectedWear === "Well-Worn")
        price *= 0.82;

    if(selectedWear === "Battle-Scarred")
        price *= 0.70;

    if(selectedStatTrak)
        price *= 1.18;


    document
        .getElementById("detailPrice")
        .innerText =
        formatPrice(Math.round(price));

