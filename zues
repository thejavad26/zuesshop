        .trim()
        .toLowerCase();


    let list = products.filter(product => {

        const categoryMatch =
            currentFilter === "all" ||
            product.category === currentFilter;

        const searchMatch =
            !query ||
            product.name.toLowerCase().includes(query) ||
            product.weapon.toLowerCase().includes(query);

        return categoryMatch && searchMatch;

    });


    container.innerHTML = "";


    if(list.length === 0){

