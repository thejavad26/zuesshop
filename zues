            `📊 Float: ${item.float}\n` +
            `💰 ${formatPrice(item.price)}\n\n`;

    });


    const total =
        cart.reduce(
            (sum,item) =>
                sum + item.price,
            0
        );


    message +=
        "💵 مجموع: " +
        formatPrice(total);


    const telegramURL =
        "https://t.me/" +
        TELEGRAM_USERNAME +
