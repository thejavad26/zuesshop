        product.image
        ?
        `<img src="${product.image}" alt="${product.name}">`
        :
        `<div class="detail-placeholder">🔫</div>`;


    renderSkinOptions();

    resetWearOptions();

    resetStatOptions();

    updateDetailPrice();

    generateFloat();


